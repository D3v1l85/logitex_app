<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvDetalleAlbara"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Detall: #ALB-501"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvDetalleDireccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Direcció: C/ Aragó 123, Barcelona"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvEstadoActual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estat: PENDENT"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#0056b3"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btnAbrirEscaner"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="ESCANEJAR QR"
            android:backgroundTint="#4CAF50"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"
            app:cornerRadius="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_rounded_white"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tvManualHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="- O introdueix el codi manualment -"
                android:layout_gravity="center"
                android:textColor="#666666"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/etCodigoManualRuta"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Ex: 12345"
                android:inputType="number"
                android:background="@android:color/white"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="12dp"
                android:elevation="1dp"/>

            <Button
                android:id="@+id/btnConfirmarManual"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="CONFIRMAR CODI MANUAL"
                android:backgroundTint="#2196F3"
                android:textStyle="bold"
                app:cornerRadius="8dp"/>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/btnAbrirIncidencia"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="REPORTAR INCIDÈNCIA"
            android:backgroundTint="#F44336"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"/>

    </LinearLayout>
</ScrollView>