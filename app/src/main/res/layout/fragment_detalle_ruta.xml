<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvDetalleAlbara"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Ordre: ORD-001"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:strokeColor="#E0E0E0"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvDetalleDireccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Albarà: ALB-123\nDirecció: C/ Falsa 123"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvEstadoActual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Estat: PENDENT"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#0056b3"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMapa"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:strokeColor="#E0E0E0"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@android:color/white">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.google.android.gms.maps.MapView
                    android:id="@+id/mapViewDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <Button
                    android:id="@+id/btnVerMapa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="16dp"
                    android:text="@string/btn_veure_ruta"
                    android:backgroundTint="#0056b3"
                    android:textColor="@android:color/white"
                    android:textStyle="bold" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btnAbrirEscaner"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            tools:text="ESCANEJAR QR"
            android:backgroundTint="#4CAF50"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"
            app:cornerRadius="8dp"/>

        <LinearLayout
            android:id="@+id/layoutManualInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:layout_marginBottom="24dp"
            android:elevation="1dp">

            <TextView
                android:id="@+id/tvManualHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hint_codi_manual"
                android:layout_gravity="center"
                android:textColor="#666666"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/etCodigoManualRuta"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="@string/hint_ex_codi"
                android:importantForAutofill="no"
                android:inputType="number"
                android:background="@android:color/white"
                android:textColor="#000000"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnConfirmarManual"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="@string/btn_confirmar_manual"
                android:backgroundTint="#2196F3"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                app:cornerRadius="8dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnAbrirIncidencia"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/reportar_incidencia"
            android:backgroundTint="#F44336"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"/>

    </LinearLayout>
</ScrollView>