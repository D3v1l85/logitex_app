<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:padding="16dp">

    <!-- Capçalera amb el Palet -->
    <TextView
        android:id="@+id/tvDetallePalet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Palet: #10203"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="16dp" />

    <!-- Targeta d'Ubicació (El més important pel mosso) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#E3F2FD"> <!-- Fons blau clar per destacar -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ubicació al Magatzem"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#0056b3"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvDetalleUbicacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Passadís 4 - Estanteria B"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#333333"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Targeta d'Informació del Producte -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dades del Palet"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvDetalleEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estat: PENDENT DE RECOLLIDA"
                android:textSize="16sp"
                android:textColor="#FFA500"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pes aproximat: 250 kg"
                android:textSize="16sp"
                android:textColor="#666666"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Espai en blanc per empènyer el botó cap a baix -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- BOTÓ DE INCIDÈNCIA -->
    <Button
        android:id="@+id/btnAbrirIncidenciaPicking"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:text="NOTIFICAR INCIDÈNCIA"
        android:backgroundTint="#d32f2f"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:cornerRadius="8dp"
        android:layout_marginBottom="8dp"/>

    <!-- BOTÓ D'ACCIÓ PRINCIPAL -->
    <Button
        android:id="@+id/btnEscanearPalet"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:text="ESCANETJAR I RECOLLIR"
        android:backgroundTint="#0056b3"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:cornerRadius="8dp"
        android:layout_marginBottom="16dp"/>

</LinearLayout>