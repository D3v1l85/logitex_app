<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_alerta"
                app:tint="#d32f2f" />

            <TextView
                android:id="@+id/tvIncidenciaTitulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Títol de la Incidència"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginStart="12dp" />

            <TextView
                android:id="@+id/tvIncidenciaEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="obert"
                android:textStyle="bold"
                android:textColor="#FFA500"
                android:textAllCaps="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvIncidenciaDescripcio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descripció detallada del problema..."
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvIncidenciaPrioritat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Prioritat: Alta"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#d32f2f" />

            <TextView
                android:id="@+id/tvIncidenciaAutor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Per: Joan"
                android:textSize="12sp"
                android:textColor="#999999" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
